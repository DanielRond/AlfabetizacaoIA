# ================================================================
# Configurações do Servidor Python (Flask)
# ================================================================
FLASK_ENV=development
PORT=5000
PYTHON_API_URL=http://localhost:5000/v1/messages/inbound

# ================================================================
# Inteligência Artificial (Escolha 'gemini' ou 'ollama')
# ================================================================
IA_PROVIDER=gemini

# Configurações do Gemini
GEMINI_API_KEY=sua_api_aqui
GEMINI_MODEL=gemini-flash-latest

# Configurações do Ollama (caso use local)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Transcrição de Áudio (Speech-to-Text)
WHISPER_MODEL=base

# ================================================================
# Bancos de Dados, Vetores e Diretórios
# ================================================================
DATABASE_URL=sqlite:///./data/alfabot.db
CHROMA_PATH=./data/chroma
WHATSAPP_MEDIA_DIR=./data/audio_temp
WHATSAPP_SESSION_DIR=./data/whatsapp_sessions

# ================================================================
# Text-to-Speech (TTS - Ex: Kokoro, local, CPU)
# ================================================================
TTS_ENABLED=true
TTS_VOICE=pm_santa
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin