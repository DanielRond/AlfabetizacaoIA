# ================================================================
# Servidor Python (Flask)
# ================================================================
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# ================================================================
# Inteligência Artificial (Escolha 'ollama' ou 'gemini')
# ================================================================
IA_PROVIDER=ollama

# Ollama (geração local)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Gemini (alternativa via API)
GEMINI_API_KEY=sua_api_aqui
GEMINI_MODEL=gemini-flash-latest

# ================================================================
# Text-to-Speech (TTS - Kokoro, local, CPU)
# ================================================================
TTS_ENABLED=true
TTS_VOICE=pf_dora
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# ================================================================
# Conector WhatsApp (Node)
# O conector também aceita um .env próprio em
# apps/whatsapp-connector/.env (veja apps/whatsapp-connector/.env.example)
# ================================================================
PYTHON_API_URL=http://localhost:5000
WHATSAPP_SESSION_DIR=.wwebjs_auth
WHATSAPP_MEDIA_DIR=data/media_in
MEDIA_BASE_DIR=
