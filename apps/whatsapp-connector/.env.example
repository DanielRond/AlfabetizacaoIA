# ================================================================
# Conector WhatsApp (Node) - Curumim Marajoara
# ================================================================

# URL do backend Python (API interna Node <-> Python)
PYTHON_API_URL=http://localhost:5000

# Diretório da sessão WhatsApp persistida (LocalAuth)
WHATSAPP_SESSION_DIR=.wwebjs_auth

# Navegador usado pelo Puppeteer (ex.: /usr/bin/brave-browser)
# Se vazio, usa o Chromium embutido do puppeteer
WHATSAPP_BROWSER_PATH=

# Diretório onde o conector salva mídia recebida do WhatsApp
WHATSAPP_MEDIA_DIR=data/media_in

# Base para resolver o media_ref gerado pelo backend Python
# (padrão: raiz do repositório, que é onde o backend escreve em data/audios)
MEDIA_BASE_DIR=

# Nível de log (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Timeout HTTP para o backend Python (ms)
REQUEST_TIMEOUT_MS=120000

# Tentativas extras após falha de rede/5xx no POST /v1/messages/inbound
REQUEST_RETRIES=2

# Atraso base do backoff exponencial entre tentativas (ms)
RETRY_BASE_DELAY_MS=500

# Retenção de mídia (horas): remove mídia de entrada mais antiga que o limite
MEDIA_RETENTION_HOURS=24
