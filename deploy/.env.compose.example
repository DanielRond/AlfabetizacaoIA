# =====================================================================
# .env do Docker Compose — Curumim Marajoara
#
# Uso:
#   cp deploy/.env.compose.example deploy/.env
#   make -C deploy up        (ou: make -C deploy up-ollama p/ IA local)
#
# Este arquivo é injetado nos containers via env_file: .env do
# compose.yaml. Alguns valores são SOBRESCRITOS pelo bloco `environment`
# do compose (necessários para a rede interna):
#   OLLAMA_API_URL → http://ollama:11434/api/generate
#   PYTHON_API_URL → http://backend:5000
#   MEDIA_BASE_DIR → /app
# Mantemos os valores abaixo apenas como documentação do padrão.
#
# NUNCA versionar o deploy/.env (a cópia com chaves reais). Este .example
# é o modelo versionado — mantenha GEMINI_API_KEY apenas como placeholder.
# =====================================================================

# =====================================================================
# Backend Python (Flask + Gunicorn)
# =====================================================================
PORT=5000
# Vale para os dois serviços: Python (Loguru) e Node (pino).
# O Loguru aceita caixa alta/baixa; use minúsculo p/ compatibilidade.
LOG_LEVEL=info

# =====================================================================
# Inteligência Artificial (escolha 'ollama' ou 'gemini')
# =====================================================================
IA_PROVIDER=ollama

# Geração local (Ollama). Dentro do compose a URL é sobrescrita para o
# hostname do serviço ollama (rede curumim-net).
# Para o Ollama subir SEMPRE junto do up padrão, defina COMPOSE_PROFILES=ollama neste arquivo.
OLLAMA_API_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=llama3.2

# Alternativa via nuvem: descomente e preencha se IA_PROVIDER=gemini
# GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-flash-latest

# =====================================================================
# TTS (Kokoro, local, CPU)
# Os modelos já vêm na imagem (baixados no build, deploy/Dockerfile.backend);
# aqui só escolhemos a voz e o caminho (relativo ao WORKDIR /app).
# =====================================================================
TTS_ENABLED=true
TTS_VOICE=pm_santa
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# =====================================================================
# Conector Node (whatsapp-web.js)
# =====================================================================
# Sobrescrita pelo compose: PYTHON_API_URL=http://backend:5000
PYTHON_API_URL=http://backend:5000
# Chromium do sistema (instalado na imagem; evita Chrome for Testing)
WHATSAPP_BROWSER_PATH=/usr/bin/chromium
# Sobrescrito pelo compose: MEDIA_BASE_DIR=/app
MEDIA_BASE_DIR=/app
WHATSAPP_SESSION_DIR=.wwebjs_auth
WHATSAPP_MEDIA_DIR=data/media_in
# Timeout/retries do POST /v1/messages/inbound (backoff exponencial)
REQUEST_TIMEOUT_MS=120000
REQUEST_RETRIES=2
RETRY_BASE_DELAY_MS=500

# =====================================================================
# Retenção de mídia (horas) — usada pelo backend (TTS) e pelo conector
# =====================================================================
MEDIA_RETENTION_HOURS=24
